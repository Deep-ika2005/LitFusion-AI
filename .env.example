# Copy to .env.local and fill in the values you need.
# Every variable below except SCOPUS_API_KEY is already configured in this project.

# --- Supabase (saved papers library) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI (AI summaries / analysis) ---
OPENAI_API_KEY=

# --- OpenAlex (paper search) ---
# Free API key from https://openalex.org/settings/api — strongly recommended.
# Anonymous OpenAlex requests are rate-limited (HTTP 429) whenever the shared search
# cluster is under load, which surfaces as a failed search. A key removes that limit.
OPENALEX_API_KEY=
# Contact email for OpenAlex' polite pool. Use a real monitored address.
OPENALEX_MAILTO=

# --- Scopus verification (OPTIONAL) ---
# Elsevier Scopus API key, from https://dev.elsevier.com/apikey
# With a key set, Scopus coverage is verified live through api.elsevier.com:
#   ISSN lookup  GET https://api.elsevier.com/content/serial/title/issn/{issn}
#   DOI lookup   GET https://api.elsevier.com/content/search/scopus?query=DOI({doi})
# Without a key, coverage falls back to the local Scopus source list
# (data/scopus-sources.json, built with `npm run scopus:registry -- <csv>`).
# If neither is available every paper is reported as "Scopus: Unknown" — the app
# never guesses Scopus indexing.
SCOPUS_API_KEY=

# --- Journal quartile verification (OPTIONAL) ---
# There is no free official SCImago/JCR quartile API. Quartiles are verified by
# ISSN join against data/journal-quartiles.json, built from YOUR OWN licensed
# export (SCImago SJR CSV or Clarivate JCR export):
#   npm run quartile:registry -- <scimago-or-jcr-export.csv>
# Without a registry entry every paper reports "Quartile unavailable" — the app
# never guesses a quartile from title, publisher, or citations.
#
# Live fallback (only if you hold a license / host a mirror; keys stay server-side):
#   Clarivate JCR:  JCR_API_KEY=<your-clarivate-key>
#   Generic mirror answering GET {QUARTILE_API_URL}?issn={issn} with
#   JSON { "quartile": "Q1", "category": "...", "year": 2024 }:
# QUARTILE_API_URL=
# QUARTILE_API_KEY=
JCR_API_KEY=

# --- Hybrid ranking weights (OPTIONAL) ---
# Defaults: relevance 0.40, quartile 0.30, recency 0.20, citations 0.10.
# Values are renormalized to sum to 1. Citations use log10 dampening so old,
# highly cited papers do not automatically dominate.
# RANKING_WEIGHT_RELEVANCE=0.40
# RANKING_WEIGHT_QUARTILE=0.30
# RANKING_WEIGHT_RECENCY=0.20
# RANKING_WEIGHT_CITATIONS=0.10
